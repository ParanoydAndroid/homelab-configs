# ==============================================================================
# Mesh Stack Environment Secrets (mesh/.env.example)
#
# Connects to Private Internet Access (PIA) for the Tailscale exit node and
# provisions the primary Tailscale subnet router.
# Global variables from root .env are synced automatically by 'homelab.sh setup'.
# ==============================================================================

# Private Internet Access (PIA) Credentials for Exit Node
VPN_USER=
VPN_PASS=
PIA_REGION=us_east,us_chicago,us_nyc

# Tailscale Pre-Authentication Key (optional after initial node registration)
TS_AUTHKEY=
