# ==============================================================================
# Homepage Per-Stack Environment Secrets (homepage/.env.example)
#
# Populate HOMEPAGE_VAR_PIHOLE_KEY with the Pi-hole password/API token used by
# the Pi-hole widget in .configs/homepage/services.yaml. Global variables from
# root .env are automatically synced into homepage/.env by 'homelab.sh setup'.
# ==============================================================================
HOMEPAGE_VAR_PIHOLE_KEY=

