# ==============================================================================
# Torrent Stack Environment Secrets (torrent/.env.example)
#
# Credentials for Private Internet Access (PIA) and qBittorrent WebUI.
# Global variables from root .env are synced automatically by 'homelab.sh setup'.
# ==============================================================================
VPN_USER=
VPN_PASS=
PIA_REGION=ca_ontario,ca_toronto,ca_montreal
QBITTORRENT_PASSWORD=

# Scratch buffer directory for active/incomplete torrent downloads
TORRENT_INCOMPLETE_DIR=/volume2/docker/qbittorrent/data/incomplete
