# ==============================================================================
# Seerr Per-Stack Secrets (seerr/.env.example)
#
# Define the static API key for Seerr. Seerr reads this variable on startup to
# configure the active API key directly rather than generating a random token.
# Global variables from root .env are synced into seerr/.env by 'homelab.sh setup'.
# ==============================================================================
SEERR_API_KEY=

