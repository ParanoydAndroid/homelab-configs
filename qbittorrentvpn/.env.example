# ==============================================================================
# qBittorrentVPN Per-Stack Environment Secrets (qbittorrentvpn/.env.example)
#
# Populate with Private Internet Access (PIA) OpenVPN credentials and the
# qBittorrent WebUI password used by the Homepage dashboard widget. Global
# variables from root .env are synced into qbittorrentvpn/.env by 'homelab.sh setup'.
# ==============================================================================
VPN_USER=
VPN_PASS=
QBITTORRENT_WIDGET_PASSWORD=
