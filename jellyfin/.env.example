# ==============================================================================
# Jellyfin Per-Stack Environment Secrets (jellyfin/.env.example)
#
# Populate JELLYFIN_WIDGET_KEY with a Jellyfin API key (Dashboard -> API Keys)
# for the Homepage dashboard widget. Global variables from root .env are
# automatically synced into jellyfin/.env by 'homelab.sh setup'.
# ==============================================================================
JELLYFIN_WIDGET_KEY=
