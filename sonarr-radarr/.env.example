# ==============================================================================
# Media Automation Suite Per-Stack Secrets (sonarr-radarr/.env.example)
#
# Define arbitrary 32-character hexadecimal API keys for deterministic service
# authentication. The *arr containers inject these directly via Servarr env vars:
#   - RADARR__AUTH__APIKEY
#   - SONARR__AUTH__APIKEY
#   - PROWLARR__AUTH__APIKEY
# ==============================================================================
RADARR_API_KEY=
SONARR_API_KEY=
PROWLARR_API_KEY=
