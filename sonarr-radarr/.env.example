# ==============================================================================
# Media Automation Suite Per-Stack Secrets (sonarr-radarr/.env.example)
#
# Populate with the API keys generated by Radarr, Sonarr, and Prowlarr
# (Settings -> General -> Security -> API Key) for Homepage widget integration.
# Global variables from root .env are synced into sonarr-radarr/.env by 'homelab.sh setup'.
# ==============================================================================
RADARR_WIDGET_KEY=
SONARR_WIDGET_KEY=
PROWLARR_WIDGET_KEY=
