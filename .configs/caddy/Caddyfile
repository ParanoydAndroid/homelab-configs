{
    email admin@kamakakai.com
}

(cloudflare_tls) {
    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN}
    }
}

# Physical UGREEN NAS Host Management Portal (UGOS):
nas.kamaka.tech {
    import cloudflare_tls
    reverse_proxy https://192.168.255.1:9443 {
        transport http {
            tls_insecure_skip_verify
        }
    }
}

# Direct Client File Delivery Endpoint:
download.kamaka.tech {
    import cloudflare_tls
    root * /downloads
    file_server browse
}
